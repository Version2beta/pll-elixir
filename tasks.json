{
  "format": "mix format",
  "format_check": "mix format --check-formatted",
  "check": "MIX_ENV=test mix compile --warnings-as-errors",
  "protected": [
    "(^|/)README\\.md$",
    "^test/",
    "^config/",
    "^lib/pll/(error|segment|rate|pacer|span)\\.ex$",
    "^mix\\.exs$",
    "^\\.formatter\\.exs$",
    "^\\.gitignore$",
    "^LICENSE$",
    "^lib/pll/(follower|follower_config|observation|status|state|rate_core|pacer_core|span_core|segment_core)\\.ex$"
  ],
  "tasks": [
    {
      "id": "T1",
      "title": "Rate: exact factories, formatting and input envelopes",
      "test": "mix test test/pll/rate_test.exs --seed 0",
      "expect": [
        "^Result: 9 passed$"
      ],
      "tier": "normal"
    },
    {
      "id": "T2",
      "title": "Pacer and Span: untrimmed issuance, bounds, lazy snapshots and README examples",
      "test": "mix test test/pll/pacer_test.exs test/pll/span_test.exs test/pll/readme_test.exs --seed 0",
      "expect": [
        "^Result: 21 passed$"
      ],
      "tier": "normal"
    },
    {
      "id": "T3",
      "title": "Trim transitions and independent rational differential model",
      "test": "mix test test/pll/trim_test.exs test/pll/model_test.exs --seed 0",
      "expect": [
        "^Result: 8 passed$"
      ],
      "tier": "normal"
    },
    {
      "id": "S2-config",
      "title": "Configuration validation and shared follower values",
      "test": "mix test test/pll/follower_config_test.exs --seed 0",
      "expect": [
        "^Result: 4 passed$"
      ],
      "tier": "normal"
    },
    {
      "id": "S2-mapping",
      "title": "Anchoring, scalar validation and signed mapping",
      "test": "mix test test/pll/follower_mapping_test.exs --seed 0",
      "expect": [
        "^Result: 4 passed$"
      ],
      "tier": "normal"
    },
    {
      "id": "S2-loop",
      "title": "Inlier equations, lifecycle, unsupported boundary and pacer trim",
      "test": "mix test test/pll/follower_loop_test.exs --seed 0",
      "expect": [
        "^Result: 9 passed$"
      ],
      "tier": "normal"
    },
    {
      "id": "S2-tree",
      "title": "Whole tree: all prior guarantees plus bounded Stage 2",
      "test": "mix format --check-formatted && MIX_ENV=test mix compile --warnings-as-errors && mix test --seed 0",
      "expect": [
        "^Result: 55 passed$"
      ],
      "tier": "normal"
    }
  ]
}
